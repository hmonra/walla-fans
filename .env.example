# Walla Sentry — configuration template
# Copy to .env locally and fill in. NEVER commit the .env file.

# ---- Wallapop authentication ----
# Preferred: refresh token captured once with scripts/capture_one_time.py
WALLAFANS_REFRESH_TOKEN=
WALLAFANS_REFRESH_CLIENT_ID=web
# Fallback session cookie (captured the same way) if refresh grant is not available
WALLAFANS_SESSION_COOKIE=
# Last-resort fallback: email + password (Playwright auto-login each run)
WALLAFANS_EMAIL=
WALLAFANS_PASSWORD=

# ---- Telegram bot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Your Wallapop account ----
WALLAFANS_USER_ID=USER_ID_PLACEHOLDER

# ---- PubNub (filled automatically by the capture tool) ----
# Keys are public client keys (present in the web JS bundle)
PUBNUB_SUBSCRIBE_KEY=sub-c-89405e27-d4df-4d87-aca1-d6e9118f0a0d
PUBNUB_PUBLISH_KEY=pub-c-255dc549-86f5-4abd-8b9e-921d5a02fde7
PUBNUB_AUTH_TOKEN=
PUBNUB_CHANNEL=
PUBNUB_LAST_TIMETOKEN=0

# ---- Behaviour ----
POLL_INTERVAL_MINUTES=30
DIGEST_EVENING_HOUR=21
DIGEST_MORNING_HOUR=8
DIGEST_TZ=Europe/Madrid
# Optional: cap the number of Telegram messages sent per poll run
MAX_MESSAGES_PER_RUN=5
